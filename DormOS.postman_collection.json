            "description": "🔒 PROTECTED\n\nReturns: room_id, room_number, floor, capacity, occupied, residents"
          }
        },
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
