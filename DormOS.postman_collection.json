              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_number\": \"101A\",\n  \"floor\": 1,\n  \"capacity\": 4\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/rooms", "host": ["{{base_url}}"], "path": ["api","v1","rooms"] },
            "description": "🔒 PROTECTED\n\nBody: room_number (string), floor (int), capacity (int)\nReturns: { room_id: \"uuid\" }"
          }
        },
        {
          "name": "List Rooms",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/rooms?floor=0",
              "host": ["{{base_url}}"],
              "path": ["api","v1","rooms"],
              "query": [{ "key": "floor", "value": "0", "description": "0 = all floors, 1..N = filter by floor number" }]
            },
            "description": "🔒 PROTECTED\n\nQuery: ?floor=0 (0 = all floors)\nReturns: { rooms: [...] }"
          }
