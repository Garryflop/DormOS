{
  "info": {
    "_postman_id": "dormos-v2",
    "name": "DormOS API — Full Collection",
    "description": "Base URL: http://localhost:8080\n\n=== QUICK START ===\n1. Run '1. Register' — creates your account\n2. Run '2. Login' — token saved automatically to {{token}}\n3. All other requests work automatically with Bearer {{token}}\n\n=== NOTES ===\n- Register / Login / Refresh → NO auth required\n- Everything else → needs Bearer token",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "refresh_token", "value": "", "type": "string" },
    { "key": "user_id", "value": "", "type": "string" },
    { "key": "room_id", "value": "", "type": "string" },
    { "key": "issue_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "🏥 0. Health Check",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] },
            "description": "✅ PUBLIC — no token needed.\nExpected: {\"status\": \"ok\", \"service\": \"api-gateway\"}"
          }
        }
      ]
    },
    {
      "name": "🔐 Auth (PUBLIC — no token needed)",
      "item": [
        {
          "name": "1. Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.user_id) {",
                  "    pm.collectionVariables.set('user_id', json.user_id);",
                  "    console.log('✅ Registered! user_id =', json.user_id);",
                  "} else {",
                  "    console.log('❌ Register failed:', JSON.stringify(json));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@dormos.kz\",\n  \"password\": \"password123\",\n  \"full_name\": \"Diasbek Admin\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/register", "host": ["{{base_url}}"], "path": ["api","v1","auth","register"] },
            "description": "✅ PUBLIC — no Authorization header needed.\n\nReturns: { \"user_id\": \"uuid\" }"
          }
        },
        {
          "name": "2. Login ← RUN THIS FIRST",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access_token) {",
                  "    pm.collectionVariables.set('token', json.access_token);",
                  "    pm.collectionVariables.set('refresh_token', json.refresh_token);",
                  "    console.log('✅ Token saved! You can now use all protected endpoints.');",
                  "} else {",
                  "    console.log('❌ Login failed:', JSON.stringify(json));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@dormos.kz\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api","v1","auth","login"] },
            "description": "✅ PUBLIC — no Authorization header needed.\n\nReturns: { \"access_token\": \"...\", \"refresh_token\": \"...\" }\n\n⭐ The test script auto-saves the token to {{token}} — all protected requests will work immediately after this."
          }
        },
        {
          "name": "3. Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access_token) {",
                  "    pm.collectionVariables.set('token', json.access_token);",
                  "    pm.collectionVariables.set('refresh_token', json.refresh_token);",
                  "    console.log('✅ Token refreshed!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/refresh", "host": ["{{base_url}}"], "path": ["api","v1","auth","refresh"] },
            "description": "✅ PUBLIC — no Authorization header needed.\nUse this when the access_token expires.\nReturns new access_token + refresh_token."
          }
        }
      ]
    },
    {
      "name": "👤 Auth (PROTECTED — needs token)",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/profile", "host": ["{{base_url}}"], "path": ["api","v1","auth","profile"] },
            "description": "🔒 PROTECTED — requires Bearer token.\n\nReturns: user_id, email, full_name, role, created_at"
          }
        },
        {
          "name": "Validate Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"access_token\": \"{{token}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/validate", "host": ["{{base_url}}"], "path": ["api","v1","auth","validate"] },
            "description": "🔒 PROTECTED — requires Bearer token.\n\nReturns: { is_valid, user_id, role }"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"access_token\": \"{{token}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/logout", "host": ["{{base_url}}"], "path": ["api","v1","auth","logout"] },
            "description": "🔒 PROTECTED — requires Bearer token.\n\nReturns: { success: true }"
          }
        }
      ]
    },
    {
      "name": "🏠 Rooms",
      "item": [
        {
          "name": "Create Room",
